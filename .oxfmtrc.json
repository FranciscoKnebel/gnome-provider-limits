{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": true,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "coverage/",
    ".worktrees/",
    "pages/_site/",
    "pages/.jekyll-cache/",
    "pages/vendor/",
    "src/po/**",
    "package-lock.json"
  ]
}
