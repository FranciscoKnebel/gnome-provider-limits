{
  "name": "gnome-provider-limits",
  "version": "0.4.5",
  "private": true,
  "description": "GNOME Shell extension that shows usage limits of Codex, Claude, OpenCode Go, Grok/SuperGrok, Cursor, and Google in the top bar.",
  "homepage": "https://github.com/FranciscoKnebel/gnome-provider-limits",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FranciscoKnebel/gnome-provider-limits.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:stylesheet",
    "build:stylesheet": "node scripts/build-stylesheet.mjs",
    "build:tests": "rm -rf dist-test && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist dist-test src/schemas/gschemas.compiled",
    "lint": "oxlint --type-aware --import-plugin --deny-warnings --report-unused-disable-directives",
    "lint:ci": "npm run lint -- --format=github",
    "lint:fix": "oxlint --type-aware --import-plugin --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests && npm run typecheck:scripts",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "npm run test:jasmine",
    "test:jasmine": "npm run build:tests && c8 jasmine --config=jasmine.json",
    "test:gjs": "node scripts/test-gjs.mjs",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "schema:compile": "glib-compile-schemas src/schemas",
    "compile:mo": "node scripts/prepare-languages.mjs",
    "copy:assets": "node scripts/copy-assets.mjs && npm run compile:mo",
    "pack": "npm run clean && npm run build && npm run schema:compile && npm run copy:assets && cd dist && zip -r ../dist/gnome-provider-limits@franciscoknebel.com.shell-extension.zip . -x '*.zip' && cd .. && python3 scripts/check-package.py",
    "install:local": "npm run pack && gnome-extensions install --force dist/*.zip",
    "uninstall:local": "gnome-extensions uninstall gnome-provider-limits@franciscoknebel.com",
    "check:static": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm run test:tooling",
    "check:fast": "npm run check:static",
    "check": "npm run check:static && npm run test:catalogs && npm run test:node && npm run test",
    "check:all": "npm run check && npm run test:gjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "release": "bash scripts/release.sh",
    "test:catalogs": "node --test tests/catalogs.test.mjs",
    "test:node": "node --test tests/helpers/*.test.mjs tests/ui/*.test.mjs tests/readers/*.test.mjs"
  },
  "devDependencies": {
    "@girs/adw-1": "^1.10.0-4.0.0-rc.9",
    "@girs/clutter-18": "^18.0.0-4.0.0-rc.9",
    "@girs/gio-2.0": "^2.88.0-4.0.0-rc.9",
    "@girs/gjs": "^4.0.0-rc.9",
    "@girs/glib-2.0": "^2.88.0-4.0.0-rc.9",
    "@girs/gnome-shell": "^50.0.0",
    "@girs/gobject-2.0": "^2.88.0-4.0.0-rc.9",
    "@girs/gtk-4.0": "^4.23.0-4.0.0-rc.9",
    "@girs/soup-3.0": "^3.6.6-4.0.4",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^26.6.6",
    "c8": "^11.0.0",
    "jasmine": "^7.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^7.0.2005",
    "semver": "^7.8.6",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.20.0"
}
