#: src/readers/grok.ts
msgid "Used % (credits)"
msgstr "Verbraucht % (Guthaben)"

msgid "Remaining % (credits)"
msgstr "Verbleibend % (Guthaben)"

msgid "Reset at (credits)"
msgstr "Zurücksetzung (Guthaben)"

msgid "Purchased credits"
msgstr "Gekauftes Guthaben"

msgid "Shared subscription credits"
msgstr "Gemeinsames Abonnementguthaben"

msgid "Grok: no valid login. Run `grok login` to sign in."
msgstr "Grok: keine gültige Anmeldung. Führen Sie `grok login` aus, um sich anzumelden."

msgid "Grok: login rejected. Run `grok login` to sign in again."
msgstr "Grok: Anmeldung abgelehnt. Führen Sie `grok login` aus, um sich erneut anzumelden."

msgid "Grok: subscription credits unavailable. Try again later."
msgstr "Grok: Abonnementguthaben nicht verfügbar. Versuchen Sie es später erneut."

#: src/ui/prefs/provider-page.ts
msgid "Authentication file"
msgstr "Authentifizierungsdatei"

msgid "Sign in with `grok login`."
msgstr "Melden Sie sich mit `grok login` an."

msgid "Leave the authentication file empty to use $GROK_HOME/auth.json or ~/.grok/auth.json."
msgstr "Lassen Sie die Authentifizierungsdatei leer, um $GROK_HOME/auth.json oder ~/.grok/auth.json zu verwenden."

